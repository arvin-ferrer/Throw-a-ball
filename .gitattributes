# Enforce consistent LF line endings across Windows, macOS, and Linux
* text=auto eol=lf

# Explicit text files
*.luau text eol=lf
*.lua text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.csv text eol=lf

# Explicit binary assets (migrate to Git LFS if 3D/audio assets exceed ~100MB)
*.glb binary
*.gltf binary
*.fbx binary
*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.rbxm binary
*.rbxmx binary
