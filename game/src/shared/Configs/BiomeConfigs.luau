--!strict
--[[
	BiomeConfigs.luau
	Canonical 3 MVP Biomes (Emerald Meadow, Frostbite Cavern, Molten Caldera),
	mob tables (including 10 Emerald Meadow Base + Natural Area Elite archetypes & ballistic ranged specs),
	Boss stats, dynamic +35%/player HP scaling, and 5-Min Overcharged cadence.
]]

export type MobRangedAttackSpec = {
	projectileId: string,
	damage: number,
	speed: number,
	gravity: number,
	highArc: boolean,
	maxPitchDeg: number,
	minRange: number,
	maxRange: number,
	telegraphSec: number,
	cooldownSec: number,
	hitRadius: number,
	aoeRadius: number,
	volleyCount: number,
	volleyIntervalSec: number,
	spreadDeg: number,
	slowDuration: number,
	knockbackStrength: number,
	leadSeconds: number,
	color: { number },
}

export type MobChargeSpec = {
	minRange: number,
	maxRange: number,
	telegraphSec: number,
	chargeSpeed: number,
	chargeDuration: number,
	recoverySec: number,
	cooldownSec: number,
	damage: number,
	hitRadius: number,
	knockbackStrength: number,
}

export type MobConfig = {
	id: string,
	displayName: string,
	biomeId: string,
	isElite: boolean?,
	archetype: string?,
	maxHP: number,
	moveSpeed: number,
	attackDamage: number,
	attackRange: number,
	attackCooldown: number,
	aggroRange: number?,
	leashRange: number?,
	patrolRadius: number?,
	preferredRangeMin: number?,
	preferredRangeMax: number?,
	expReward: number,
	coinReward: number,
	ballDmgGain: number,
	respawnSec: number,
	primaryColor: { number },
	accentColor: { number },
	rangedAttack: MobRangedAttackSpec?,
	chargeSpec: MobChargeSpec?,
}

export type BossAttackSpec = {
	id: string,
	displayName: string,
	telegraphSec: number,
	cooldownSec: number,
	damage: number,
	radius: number,
	kind: "Shockwave" | "Projectile" | "Cone" | "RingDrop" | "Geysers",
}

export type BossConfig = {
	id: string,
	displayName: string,
	biomeId: string,
	baseHP: number,
	moveSpeed: number,
	participationCoins: number,
	participationExp: number,
	participationGems: number,
	winnerBonusCoins: number,
	winnerBonusGems: number,
	pvpKillGems: number,
	primaryColor: { number },
	accentColor: { number },
	attacks: { BossAttackSpec },
}

export type BiomeConfig = {
	id: string,
	order: number,
